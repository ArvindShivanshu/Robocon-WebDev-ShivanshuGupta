# Server Port
PORT=5001

# Supabase PostgreSQL Connection String
# Example format from Supabase -> Project Settings -> Database -> Connection string (NodeJS / URI):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase API (Optional for direct JS client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
